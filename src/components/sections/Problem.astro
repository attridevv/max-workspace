<section class="section problem" id="problem">
  <div class="container">
    <p class="eyebrow" data-reveal>The problem</p>

    <div class="problem-grid">
      <h2 class="problem-title" data-reveal style="--reveal-delay: 80ms">
        Your life is happening faster than you can remember it.
      </h2>

      <div class="problem-body">
        <div class="drifts" data-reveal style="--reveal-delay: 160ms">
          <p class="drift">Days blur together.</p>
          <p class="drift">Goals become vague.</p>
          <p class="drift">Progress becomes difficult to see.</p>
          <p class="drift">Ideas disappear.</p>
        </div>

        <div class="problem-copy" data-reveal style="--reveal-delay: 200ms">
          <p>
            Most of us take in more information in a week than we could have a century ago — and document
            almost nothing of our own lives. We scroll through other people's stories and forget our own.
          </p>
          <p>
            Max Workspace turns everyday life into something visible and reviewable. Not a diary. Not a
            second job. Two pages, kept honestly.
          </p>
        </div>
      </div>
    </div>

    <figure class="fade-strip" data-reveal style="--reveal-delay: 120ms">
      <div class="strip" aria-hidden="true">
        {Array.from({ length: 30 }, (_, i) => <span class:list={['fday', { marked: [3, 14, 22, 27].includes(i + 1) }]}></span>)}
      </div>
      <figcaption class="annot">A month without a record — thirty days, four you can still name.</figcaption>
    </figure>
  </div>
</section>

<style>
  .problem-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(32px, 6vw, 88px); margin-top: 40px; }
  .problem-title { max-width: 18ch; }
  .drifts { display: flex; flex-direction: column; }
  .drift { font-family: var(--serif); font-style: italic; font-variation-settings: 'opsz' 30; font-size: clamp(1.25rem, 2.1vw, 1.65rem); line-height: 1.3; color: var(--ink); padding-block: clamp(12px, 1.6vw, 20px); border-bottom: 1px solid var(--line); }
  .drift:first-child { padding-top: 0; }
  .problem-copy { margin-top: clamp(24px, 3vw, 40px); display: flex; flex-direction: column; gap: 16px; color: var(--ink-2); max-width: 56ch; }
  .fade-strip { margin-top: clamp(48px, 6vw, 80px); display: flex; flex-direction: column; gap: 14px; }
  .strip { display: grid; grid-template-columns: repeat(30, 1fr); gap: clamp(3px, 0.7vw, 8px); }
  .fday { aspect-ratio: 1; border: 1px solid var(--line); border-radius: 2px; opacity: 0.5; }
  .fday.marked { background: var(--sage-tint); border-color: var(--sage); opacity: 1; }
  @media (max-width: 820px) { .problem-grid { grid-template-columns: 1fr; gap: 28px; } .problem-title { max-width: 22ch; } }
</style>
