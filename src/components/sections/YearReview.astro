---
const figures = [
  { value: '214', label: 'days documented' },
  { value: '618', label: 'kilometres run' },
  { value: '11', label: 'books read' },
  { value: '23', label: 'goals completed' },
  { value: '4', label: 'challenges attempted' },
  { value: '128', label: 'highlights kept' },
];

const prompts = [
  'What changed most this year?',
  'What did you become better at?',
  'What did you stop doing?',
  'What moments do you want to remember?',
  'What are you proud that you continued?',
];

const memories = [
  'Sunrise run on 12 July. Nobody else awake.',
  'The call with Ma in September.',
  'Deadlift personal best — 100 kg.',
];
---

<section class="section review" id="review">
  <div class="container">
    <div class="rev-head">
      <div>
        <p class="eyebrow" data-reveal>Year in review</p>
        <h2 data-reveal style="--reveal-delay: 80ms">The year, in your own handwriting.</h2>
      </div>
      <p class="lede" data-reveal style="--reveal-delay: 140ms">
        In December the companion gathers twelve months of records into a single page. Print it, paste it
        into the back of your notebook — and answer the questions while the year is still warm.
      </p>
    </div>

    <article class="annual grain" data-reveal style="--reveal-delay: 100ms">
      <header class="annual-head">
        <h3>2026 — a year in review</h3>
        <span class="mono">draft · December</span>
      </header>

      <div class="figures">
        {figures.map((f) => (
          <div class="figure">
            <span class="fvalue serif-num tabular">{f.value}</span>
            <span class="flabel mono">{f.label}</span>
          </div>
        ))}
      </div>

      <div class="annual-body">
        <div class="annual-prompts">
          <p class="mono cp-label">To answer, in ink</p>
          <ul>{prompts.map((p) => <li>{p}</li>)}</ul>
        </div>

        <div class="annual-memories">
          <p class="mono cp-label">Kept from the archive</p>
          <ul>{memories.map((m) => <li>“{m}”</li>)}</ul>
        </div>
      </div>

      <footer class="annual-foot">
        <p class="small">Not a statistics dashboard — a personal annual journal, assembled from your own pages.</p>
      </footer>
    </article>
  </div>
</section>

<style>
  .rev-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(20px, 5vw, 72px); align-items: end; }
  .rev-head h2 { margin-top: 36px; max-width: 20ch; }
  .annual { margin-top: clamp(40px, 5vw, 64px); background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-page); padding: clamp(24px, 3.4vw, 48px); background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 31px, rgba(220, 212, 195, 0.5) 31px, rgba(220, 212, 195, 0.5) 32px); }
  .annual-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; flex-wrap: wrap; border-bottom: 1px solid var(--line-2); padding-bottom: 18px; }
  .annual-head h3 { font-family: var(--serif); font-size: clamp(1.4rem, 2.4vw, 1.9rem); font-weight: 480; }
  .figures { margin-top: 26px; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 22px 16px; }
  .figure { display: flex; flex-direction: column; gap: 6px; }
  .fvalue { font-family: var(--serif); font-variation-settings: 'opsz' 90; font-weight: 460; font-size: clamp(1.5rem, 2.8vw, 2.3rem); line-height: 1; color: var(--ink); }
  .flabel { color: var(--ink-3); font-size: 0.5938rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .annual-body { margin-top: clamp(30px, 4vw, 48px); display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(24px, 4vw, 56px); }
  .cp-label { margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .annual-prompts ul { list-style: none; padding: 0; counter-reset: p; }
  .annual-prompts li { font-family: var(--serif); font-style: italic; font-variation-settings: 'opsz' 30; font-size: clamp(1.05rem, 1.7vw, 1.3rem); color: var(--ink-2); padding-block: 12px; border-bottom: 1px solid var(--line); counter-increment: p; }
  .annual-prompts li::before { content: 'q' counter(p) '.'; font-family: var(--mono); font-style: normal; font-size: 0.625rem; letter-spacing: 0.1em; color: var(--sage-deep); margin-right: 12px; }
  .annual-memories ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .annual-memories li { font-family: var(--serif); font-style: italic; font-variation-settings: 'opsz' 20; font-size: 0.9375rem; color: var(--ink-2); }
  .annual-foot { margin-top: clamp(28px, 3.6vw, 44px); border-top: 1px solid var(--line-2); padding-top: 18px; }
  @media (max-width: 900px) { .rev-head { grid-template-columns: 1fr; align-items: start; } .figures { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .annual-body { grid-template-columns: 1fr; } }
</style>
