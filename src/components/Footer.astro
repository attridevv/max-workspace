---
const year = new Date().getFullYear();
---

<footer class="footer grain">
  <div class="container">
    <div class="foot-top">
      <div class="foot-brand">
        <p class="foot-name">Max Workspace</p>
        <p class="foot-tag">Less scrolling. More living.<br />Keep the important parts.</p>
      </div>

      <div class="foot-cols">
        <div class="foot-col">
          <p class="mono">The system</p>
          <a href="#method">The two-page spread</a>
          <a href="#example">Example month</a>
          <a href="#start">Getting started</a>
        </div>
        <div class="foot-col">
          <p class="mono">The companion</p>
          <a href="https://max-workspace-app.vercel.app/app" target="_blank" rel="noopener">Open the app →</a>
          <a href="#companion">What the app does</a>
          <a href="#archive">Life archive</a>
          <a href="#privacy">Privacy</a>
        </div>
      </div>
    </div>

    <div class="foot-bottom">
      <p class="small">© {year} Max Workspace. Your journal belongs to you.</p>
      <p class="small foot-line">Your life deserves an archive.</p>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding-block: clamp(56px, 7vw, 88px) 40px; background: var(--paper); }
  .foot-top { display: flex; justify-content: space-between; gap: clamp(32px, 6vw, 96px); flex-wrap: wrap; }
  .foot-name { font-family: var(--serif); font-size: 1.4rem; font-weight: 500; letter-spacing: -0.01em; }
  .foot-tag { margin-top: 10px; color: var(--ink-3); font-size: 0.9375rem; line-height: 1.6; }
  .foot-cols { display: flex; gap: clamp(48px, 6vw, 96px); }
  .foot-col { display: flex; flex-direction: column; gap: 12px; }
  .foot-col .mono { margin-bottom: 4px; }
  .foot-col a { font-size: 0.9375rem; color: var(--ink-2); transition: color 0.3s var(--ease); }
  .foot-col a:hover { color: var(--ink); }
  .foot-bottom { margin-top: clamp(56px, 7vw, 88px); padding-top: 22px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .foot-line { font-family: var(--serif); font-style: italic; color: var(--ink-3); }
</style>
